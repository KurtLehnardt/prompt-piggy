{
  "name": "prompt-piggy",
  "version": "0.1.0",
  "private": true,
  "license": "GPL-3.0-only",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test --pass-with-no-tests",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:test": "supabase test db",
    "db:types": "supabase gen types typescript --local > src/types/database.ts",
    "guardrails": "node scripts/run-guardrails.mjs",
    "rules:schema": "UPDATE_SCHEMA=1 vitest run src/lib/rules/json-schema-sync.test.ts",
    "calibrate": "CALIBRATE=1 vitest run --config vitest.calibrate.config.ts",
    "preflight": "node scripts/preflight.mjs",
    "db:concurrency": "node scripts/db/concurrency.mjs",
    "smoke:preview": "node scripts/smoke/preview-check.mjs",
    "smoke:realtime": "node scripts/smoke/realtime-check.mjs",
    "bundle:scan": "node scripts/scan-client-bundle.mjs"
  },
  "dependencies": {
    "next": "^16.3.5",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "@supabase/ssr": "^0.9.0",
    "@supabase/supabase-js": "^2.99.2",
    "@openai/agents": "0.21.0",
    "openai": "^7.43.0",
    "zod": "^4",
    "server-only": "^0.0.1",
    "sonner": "^2.0.7",
    "lucide-react": "^0.577.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "@base-ui/react": "^1.3.0"
  },
  "devDependencies": {
    "typescript": "^5",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.3.5",
    "tailwindcss": "^4",
    "@tailwindcss/postcss": "^4",
    "shadcn": "^4.0.8",
    "vitest": "^4.1.0",
    "@playwright/test": "^1.58.2",
    "supabase": "^2.122.0",
    "jsdom": "^26",
    "@testing-library/react": "^16",
    "@testing-library/dom": "^10"
  }
}
