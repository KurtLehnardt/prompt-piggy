# dependencies
node_modules/
.pnpm-store/

# next.js
.next/
out/
# Managed by Next.js and rewritten by every `next dev` and `next build`, so it is
# not tracked (nextjs.org/docs/app/api-reference/config/typescript#next-envdts).
# CI recreates it with `next typegen` before the typecheck.
next-env.d.ts

# build and test output
coverage/
playwright-report/
test-results/
*.tsbuildinfo

# env files: the repository is public, so only .env.example is tracked (CH2-3)
.env*
!.env.example

# calibration inputs and output stay local (CH2-3)
calibration-report.json
.calibration/

# level 4 and 5 secret material stays on the operator's machine; it is loaded
# into the level_secrets table by scripts/ops/seed-level-secrets.mjs (R2-12, CH2-3)
.secrets/

# vercel
.vercel/

# supabase local state
supabase/.temp/
supabase/.branches/

# os and editor
.DS_Store
*.log
.idea/
.vscode/*
!.vscode/extensions.json
