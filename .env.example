# Prompt Piggy environment variable names (docs/ARCHITECTURE.md section 13).
# Names only. Copy to .env.local (gitignored) and fill in values there or in the
# Vercel project settings. This repository is public: never commit a value.
#
# Public (inlined into the browser bundle at build time)
NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_SUPABASE_URL=
# Set one of the next two. The app reads the publishable key, which the
# Supabase Vercel integration syncs, and falls back to the legacy anon key.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
#
# Server secrets
# Set one of the next two. The app reads the secret key, which the Supabase
# Vercel integration syncs, and falls back to the legacy service-role key.
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=
OPENAI_API_KEY=
CRON_SECRET=
# Projector token for /live/enter: at least 32 random characters. Unset keeps
# /live closed (REVIEW-2 R2-07).
LIVE_VIEW_TOKEN=
#
# Server settings (defaults are in docs/ARCHITECTURE.md section 13)
ADMIN_EMAILS=
OPENAI_CORE_MODEL=
OPENAI_HARDENING_MODEL=
OPENAI_DECISIONS_MODEL=
OPENAI_REASONING_EFFORT=
OPENAI_CORE_MAX_OUTPUT_TOKENS=
OPENAI_HARDENING_MAX_OUTPUT_TOKENS=
OPENAI_DAILY_SPEND_CAP_USD=
OPENAI_ATTEMPT_SPEND_SHARE_PCT=
PIGGY_KILL_SWITCH=
RATE_LIMIT_ATTEMPTS_PER_MIN=
RATE_LIMIT_BURST=
RATE_LIMIT_ATTEMPTS_PER_DAY=
RATE_LIMIT_WALLET_PER_MIN=
MAX_PROMPT_CHARS=
HARDENING_MAX_JOBS_PER_HOUR=
HARDENING_MAX_JOBS_PER_USER_PER_HOUR=
HARDENING_TRAFFIC_WINDOW=
HARDENING_TRAFFIC_MAX_BPS=
RAW_PROMPT_RETENTION_DAYS=
PAYMENTS_MODE=
#
# Local Supabase CLI (read by supabase/config.toml through env())
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_SECRET=
#
# Test and CI only
E2E_TEST_MODE=
ALLOW_E2E_TEST_MODE=
#
# Operator only (calibration never runs in CI)
CALIBRATE=
CALIBRATION_PROMPTS_FILE=
# Level 4 and 5 secret material, read only by scripts/ops/seed-level-secrets.mjs
# (default .secrets/level-secrets.json, gitignored; REVIEW-2 R2-12).
LEVEL_SECRETS_FILE=
